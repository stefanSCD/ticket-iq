      "name": "Provider rate limit",
      "operation": "update_ticket",
      "schema": "ErrorResponse",
      "payload": {
        "ok": false,
        "error": {
          "code": "RATE_LIMITED",
          "message": "Jira rejected this attempt due to rate limiting. Repeat approval and version checks before a retry.",

    {
      "name": "Save the exact approved proposal",
      "operation": "update_ticket",
      "schema": "UpdateRequest",
      "payload": {
        "contract_version": "1.0",
        "connection_id": "jira-demo",
        "project_id": "toolnest",
        "ticket_id": "10001",
        "expected_version": "snapshot-v1:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "approval_id": "approval-001",
        "operation_id": "save-001",
        "changes": {
          "description": {
            "type": "doc",
            "version": 1,
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Allow cancellation of reservations that have not yet been collected. After successful cancellation, email the person who made the reservation."
                  }
                ]
              }
            ]
          },
          "acceptance_criteria": {
            "type": "doc",
            "version": 1,
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "1. A reservation that has not been collected can be cancelled."
                  }
                ]
              },
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "2. A reservation that has already been collected cannot be cancelled."
                  }
                ]
              },
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "3. After a successful cancellation, email the person who made the reservation."
                  }
                ]
              }
            ]
          }
        }
      }
    },

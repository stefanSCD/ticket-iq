    {
      "name": "Reject a stale snapshot before writing",
      "operation": "update_ticket",
      "schema": "ErrorResponse",
      "payload": {
        "ok": false,
        "error": {
          "code": "VERSION_CONFLICT",
          "message": "The ticket changed after this proposal was reviewed. Read it again and obtain approval for the current snapshot.",

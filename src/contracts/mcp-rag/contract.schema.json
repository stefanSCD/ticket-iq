{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TicketIQ MCP to RAG v1",
  "description": "Internal read-only retrieval API. Behavioral and temporal invariants are specified in README.md.",
  "anyOf": [
    {
      "$ref": "#/$defs/SearchRequest"
    },
    {
      "$ref": "#/$defs/TicketSearchRequest"
    },
    {
      "$ref": "#/$defs/DocumentReadRequest"
    },
    {
      "$ref": "#/$defs/DocumentSearchResponse"
    },
    {
      "$ref": "#/$defs/TicketSearchResponse"
    },
    {
      "$ref": "#/$defs/DocumentReadResponse"
    },
    {
      "$ref": "#/$defs/ErrorResponse"
    }
  ],
  "$defs": {
    "Id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "Scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "corpus_id",
        "dataset_id",
        "project_id"
      ],
      "properties": {
        "corpus_id": {
          "$ref": "#/$defs/Id"
        },
        "dataset_id": {
          "$ref": "#/$defs/Id"
        },
        "project_id": {
          "$ref": "#/$defs/Id"
        }
      }
    },
    "TemporalFilter": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "snapshot_at"
          ],
          "properties": {
            "mode": {
              "const": "none"
            },
            "snapshot_at": {
              "type": "null"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "snapshot_at"
          ],
          "properties": {
            "mode": {
              "enum": [
                "strict",
                "best_effort"
              ]
            },
            "snapshot_at": {
              "type": "string",
              "format": "date-time"
            }
          }
        }
      ]
    },
    "Availability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "known_available_at",
        "complete"
      ],
      "properties": {
        "known_available_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "complete": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "complete": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "known_available_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      ]
    },
    "SourceVersion": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "DocumentRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "kind",
        "doc_id",
        "source_version"
      ],
      "properties": {
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "kind": {
          "const": "document"
        },
        "doc_id": {
          "$ref": "#/$defs/Id"
        },
        "source_version": {
          "$ref": "#/$defs/SourceVersion"
        }
      }
    },
    "HistoryTicketRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "kind",
        "ticket_id",
        "source_version"
      ],
      "properties": {
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "kind": {
          "const": "history_ticket"
        },
        "ticket_id": {
          "$ref": "#/$defs/Id"
        },
        "source_version": {
          "$ref": "#/$defs/SourceVersion"
        }
      }
    },
    "SourceMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "source_path",
        "url",
        "document_type",
        "status",
        "availability"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "source_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "url": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri"
            },
            {
              "type": "null"
            }
          ]
        },
        "document_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "availability": {
          "$ref": "#/$defs/Availability"
        }
      }
    },
    "Span": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "TemporalStatus": {
      "enum": [
        "not_checked",
        "verified",
        "unknown"
      ]
    },
    "Warnings": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "UNKNOWN_AVAILABILITY_INCLUDED",
          "UNKNOWN_AVAILABILITY_EXCLUDED",
          "KNOWN_FUTURE_SOURCE_EXCLUDED"
        ]
      }
    },
    "SearchRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "scope",
        "query",
        "top_k",
        "retrieval_mode",
        "temporal_filter",
        "index_revision"
      ],
      "properties": {
        "contract_version": {
          "const": "1.0"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000,
          "pattern": "\\S"
        },
        "top_k": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "retrieval_mode": {
          "enum": [
            "dense",
            "hybrid"
          ]
        },
        "temporal_filter": {
          "$ref": "#/$defs/TemporalFilter"
        },
        "index_revision": {
          "anyOf": [
            {
              "$ref": "#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "TicketSearchRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "scope",
        "query",
        "top_k",
        "retrieval_mode",
        "temporal_filter",
        "index_revision",
        "exclude_ticket_ids"
      ],
      "properties": {
        "contract_version": {
          "const": "1.0"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000,
          "pattern": "\\S"
        },
        "top_k": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "retrieval_mode": {
          "enum": [
            "dense",
            "hybrid"
          ]
        },
        "temporal_filter": {
          "$ref": "#/$defs/TemporalFilter"
        },
        "index_revision": {
          "anyOf": [
            {
              "$ref": "#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "exclude_ticket_ids": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/Id"
          }
        }
      }
    },
    "DocumentReadRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "source",
        "index_revision",
        "temporal_filter",
        "offset",
        "limit"
      ],
      "properties": {
        "contract_version": {
          "const": "1.0"
        },
        "source": {
          "$ref": "#/$defs/DocumentRef"
        },
        "index_revision": {
          "$ref": "#/$defs/Id"
        },
        "temporal_filter": {
          "$ref": "#/$defs/TemporalFilter"
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20000
        }
      }
    },
    "DocumentHit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rank",
        "score",
        "citation_id",
        "source",
        "chunk_id",
        "passage_id",
        "excerpt",
        "span",
        "metadata",
        "temporal_status"
      ],
      "properties": {
        "rank": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "score": {
          "type": "number"
        },
        "citation_id": {
          "$ref": "#/$defs/CitationId"
        },
        "source": {
          "$ref": "#/$defs/DocumentRef"
        },
        "chunk_id": {
          "$ref": "#/$defs/Id"
        },
        "passage_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "excerpt": {
          "type": "string",
          "minLength": 1
        },
        "span": {
          "$ref": "#/$defs/Span"
        },
        "metadata": {
          "$ref": "#/$defs/SourceMetadata"
        },
        "temporal_status": {
          "$ref": "#/$defs/TemporalStatus"
        }
      }
    },
    "TicketHit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rank",
        "score",
        "citation_id",
        "source",
        "chunk_id",
        "passage_id",
        "excerpt",
        "span",
        "metadata",
        "temporal_status"
      ],
      "properties": {
        "rank": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "score": {
          "type": "number"
        },
        "citation_id": {
          "$ref": "#/$defs/CitationId"
        },
        "source": {
          "$ref": "#/$defs/HistoryTicketRef"
        },
        "chunk_id": {
          "$ref": "#/$defs/Id"
        },
        "passage_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "excerpt": {
          "type": "string",
          "minLength": 1
        },
        "span": {
          "$ref": "#/$defs/Span"
        },
        "metadata": {
          "$ref": "#/$defs/SourceMetadata"
        },
        "temporal_status": {
          "$ref": "#/$defs/TemporalStatus"
        }
      }
    },
    "DocumentSearchResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "scope",
        "index_revision",
        "retrieval_profile_id",
        "retrieval_mode",
        "temporal_filter",
        "warnings",
        "returned_count",
        "results"
      ],
      "properties": {
        "ok": {
          "const": true
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "index_revision": {
          "$ref": "#/$defs/Id"
        },
        "retrieval_profile_id": {
          "$ref": "#/$defs/Id"
        },
        "retrieval_mode": {
          "enum": [
            "dense",
            "hybrid"
          ]
        },
        "temporal_filter": {
          "$ref": "#/$defs/TemporalFilter"
        },
        "warnings": {
          "$ref": "#/$defs/Warnings"
        },
        "returned_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "results": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/DocumentHit"
          }
        }
      }
    },
    "TicketSearchResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "scope",
        "index_revision",
        "retrieval_profile_id",
        "retrieval_mode",
        "temporal_filter",
        "warnings",
        "returned_count",
        "results"
      ],
      "properties": {
        "ok": {
          "const": true
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "index_revision": {
          "$ref": "#/$defs/Id"
        },
        "retrieval_profile_id": {
          "$ref": "#/$defs/Id"
        },
        "retrieval_mode": {
          "enum": [
            "dense",
            "hybrid"
          ]
        },
        "temporal_filter": {
          "$ref": "#/$defs/TemporalFilter"
        },
        "warnings": {
          "$ref": "#/$defs/Warnings"
        },
        "returned_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "results": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/TicketHit"
          }
        }
      }
    },
    "DocumentReadResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "source",
        "index_revision",
        "metadata",
        "temporal_filter",
        "temporal_status",
        "warnings",
        "content",
        "offset",
        "total_chars",
        "next_offset",
        "retrieval_profile_id",
        "citation"
      ],
      "properties": {
        "ok": {
          "const": true
        },
        "source": {
          "$ref": "#/$defs/DocumentRef"
        },
        "index_revision": {
          "$ref": "#/$defs/Id"
        },
        "metadata": {
          "$ref": "#/$defs/SourceMetadata"
        },
        "temporal_filter": {
          "$ref": "#/$defs/TemporalFilter"
        },
        "temporal_status": {
          "$ref": "#/$defs/TemporalStatus"
        },
        "warnings": {
          "$ref": "#/$defs/Warnings"
        },
        "content": {
          "type": "string",
          "maxLength": 20000
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "total_chars": {
          "type": "integer",
          "minimum": 0
        },
        "next_offset": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "retrieval_profile_id": {
          "$ref": "#/$defs/Id"
        },
        "citation": {
          "anyOf": [
            {
              "allOf": [
                {
                  "$ref": "#/$defs/EvidenceCitation"
                },
                {
                  "properties": {
                    "source": {
                      "$ref": "#/$defs/DocumentRef"
                    }
                  }
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "content": {
                "const": ""
              }
            }
          },
          "then": {
            "properties": {
              "citation": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "citation": {
                "$ref": "#/$defs/EvidenceCitation"
              }
            }
          }
        }
      ]
    },
    "ErrorResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "error"
      ],
      "properties": {
        "ok": {
          "const": false
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message",
            "retryable"
          ],
          "properties": {
            "code": {
              "enum": [
                "INVALID_REQUEST",
                "UNAUTHENTICATED",
                "FORBIDDEN",
                "SCOPE_NOT_FOUND_OR_INACCESSIBLE",
                "SOURCE_NOT_FOUND_OR_INACCESSIBLE",
                "INDEX_REVISION_UNAVAILABLE",
                "SOURCE_VERSION_UNAVAILABLE",
                "RETRIEVAL_MODE_UNSUPPORTED",
                "RATE_LIMITED",
                "INDEX_NOT_READY",
                "SERVICE_UNAVAILABLE",
                "RETRIEVAL_TIMEOUT"
              ]
            },
            "message": {
              "type": "string",
              "minLength": 1
            },
            "retryable": {
              "type": "boolean"
            },
            "retry_after_seconds": {
              "type": "number",
              "minimum": 0
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "code": {
                    "enum": [
                      "RATE_LIMITED",
                      "INDEX_NOT_READY",
                      "SERVICE_UNAVAILABLE",
                      "RETRIEVAL_TIMEOUT"
                    ]
                  }
                }
              },
              "then": {
                "properties": {
                  "retryable": {
                    "const": true
                  }
                }
              },
              "else": {
                "properties": {
                  "retryable": {
                    "const": false
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "code": {
                    "const": "RATE_LIMITED"
                  }
                }
              },
              "then": {
                "required": [
                  "retry_after_seconds"
                ]
              }
            }
          ]
        }
      }
    },
    "CitationId": {
      "type": "string",
      "pattern": "^citation-v1:[0-9a-f]{64}$"
    },
    "EvidenceCitation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "citation_id",
        "source",
        "excerpt",
        "span",
        "metadata",
        "temporal_status"
      ],
      "properties": {
        "citation_id": {
          "$ref": "#/$defs/CitationId"
        },
        "source": {
          "oneOf": [
            {
              "$ref": "#/$defs/DocumentRef"
            },
            {
              "$ref": "#/$defs/HistoryTicketRef"
            }
          ]
        },
        "excerpt": {
          "type": "string",
          "minLength": 1
        },
        "span": {
          "$ref": "#/$defs/Span"
        },
        "metadata": {
          "$ref": "#/$defs/SourceMetadata"
        },
        "temporal_status": {
          "$ref": "#/$defs/TemporalStatus"
        }
      }
    }
  }
}
